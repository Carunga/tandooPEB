{
  "name": "tandooPEB",
  "author": "seb",
  "version": "1.1.0",
  "keywords": ["pebble-app"],
  "private": true,
  "dependencies": {
    "pebble-clay": "^1.0.4"
  },
  "pebble": {
    "displayName": "tandooPEB",
    "uuid": "b0eb1f54-cbf0-444f-9b9e-77ee01da9cca",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "targetPlatforms": ["emery"],
    "capabilities": ["configurable"],
    "messageKeys": [
      "SYNC_REQUEST",
      "NEW_COUNT",
      "NEW_ITEMS",
      "DONE_COUNT",
      "DONE_IDS",
      "SYNC_STATUS",
      "ITEM_COUNT",
      "ITEM_INDEX",
      "ITEM_ID",
      "ITEM_NAME",
      "ITEM_AMOUNT",
      "SYNC_MSG"
    ],
    "watchapp": {
      "watchface": false
    },
    "resources": {
      "media": [
        {
          "type": "bitmap",
          "name": "MENU_ICON",
          "file": "images/icon.png",
          "menuIcon": true
        },
        {
          "type": "bitmap",
          "name": "LOGO_ICON",
          "file": "images/logo.png"
        },
        {
          "type": "bitmap",
          "name": "SYNC_ICON",
          "file": "images/sync_icon.png"
        },
        {
          "type": "bitmap",
          "name": "EXIT_ICON",
          "file": "images/exit_icon.png"
        }
      ]
    }
  }
}
